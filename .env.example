# Ushbu faylni .env nomi bilan saqlang va quyidagi qiymatlarni almashtiring.
# CONFIG/config.py yaratish shart emas. .env faylni Git'ga yuklamang.
# .env qiymatlari CONFIG/config.py dan ustun; process environment esa .env dan ustun.
# Alwaysdata uchun: ALWAYSDATA_UZ.md (YOUTUBE_POT_ENABLED=false).
COMPOSE_PROJECT_NAME=tg-ytdlp-bot
TZ=Asia/Tashkent

# MAJBURIY: bot username, @ belgisiz
BOT_NAME=your_bot_username
# MAJBURIY: Telegram API ma'lumotlari (my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here
# MAJBURIY: BotFather bergan token
BOT_TOKEN=1234567890:replace_with_your_bot_token
# MAJBURIY: admin Telegram user ID (bir nechta bo'lsa vergul bilan)
ADMIN=123456789
ADMIN_USERNAME=@your_username
# MAJBURIY: log kanal ID. Botni shu kanalga admin qiling.
# Barcha LOGS_* sozlamalari odatda shu kanalni ishlatadi.
LOGS_ID=-1001234567890

# Dashboard kirish ma'lumotlari: parolni almashtiring
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD='replace_with_a_long_random_password'

# IXTIYORIY: bo'sh ro'yxat = guruhga ruxsat yo'q
ADMIN_GROUP=[]
ALLOWED_GROUP=[]
# Bo'sh ro'yxat = barcha foydalanuvchilar shaxsiy chatda ishlata oladi
ALLOWED_USERS=[]

# Majburiy obuna: 0 = o'chirilgan
SUBSCRIBE_CHANNEL=0
SUBSCRIBE_CHANNEL_URL=
# Firebase o'chirilganda lokal saqlash ishlatiladi
USE_FIREBASE=false

# IXTIYORIY: alohida log kanallari (yozilmasa LOGS_ID olinadi)
# LOGS_VIDEO_ID=-1001234567890
# LOGS_NSFW_ID=-1001234567890
# LOGS_IMG_ID=-1001234567890
# LOGS_PAID_ID=-1001234567890
# LOG_EXCEPTION=-1001234567890

# IXTIYORIY: Docker'da yordamchi xizmat manzili
YOUTUBE_POT_ENABLED=true
YOUTUBE_POT_BASE_URL=http://localhost:4416
# Docker ishlatmasdan yordamchi xizmatsiz ishga tushirsangiz: false

# IXTIYORIY: proxy (ishlatmasangiz bo'sh qoldiring)
PROXY_IP=
PROXY_USER=
PROXY_PASSWORD=
# PROXY_TYPE=http
# PROXY_PORT=3128

# CONFIG/_config.py ichidagi boshqa katta harfli sozlamalarni ham
# shu nom bilan yozish mumkin. Boolean: true/false; ro'yxat: [123,456].
# # yoki $ qatnashgan parollarni bir tirnoqqa oling: 'my#pass$word'

# Optional upstream integrations. Keep the existing dump.json store by default.
DB_ENGINE=json
SQLITE_DB_PATH=DATABASE/data/tgytdlp.sqlite3
# Enable only after Chromium and the dashboard browser have been configured.
BROWSER_SESSION_ENABLED=false
BROWSER_CDP_PORT=9223
BROWSER_EXECUTABLE=
BROWSER_COOKIES_ADMIN_ONLY=true
BROWSER_KEEPALIVE_EVERY=10800
# Alwaysdata does not require Docker or WARP.
WARP_PER_TASK=false
