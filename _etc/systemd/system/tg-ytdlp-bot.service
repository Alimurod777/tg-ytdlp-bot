[Unit]
Description=Telegram YouTube-DLP Bot
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=30s
StartLimitBurst=10


[Service]
Type=simple
User=telegramdata4
WorkingDirectory=/home/telegramdata4/tg-ytdlp-bot

# Run inside bash with virtual environment activated
ExecStart=/home/telegramdata4/tg-ytdlp-bot/venv/bin/python3 /home/telegramdata4/tg-ytdlp-bot/magic.py

Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/telegramdata4/tg-ytdlp-bot/venv/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal
KillSignal=SIGINT
TimeoutStopSec=35
WatchdogSec=180
NotifyAccess=main
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=false

# Resource limits to prevent hanging
LimitNOFILE=65535
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
